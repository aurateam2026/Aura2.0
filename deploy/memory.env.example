# Copy to deploy/runtime/memory.env (host) or docker-runtime/memory.env (Docker).
# This is a shell file sourced by aura.sh. Keep export so workers inherit it.
# Enable: change the next line to 1 and restart the demo/container.
export AURA_MEMORY_ENABLE=0

# Managed local summarizer: use an accelerator separate from --gpus.
# Example: demo on accelerators 0,1; memory on accelerator 2.
export MEMORY_VLM_GPU=2
export MEMORY_VLM_PORT=8003
export MEMORY_VLM_GPU_UTIL=0.3
export MEMORY_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
export MEMORY_VLM_SERVED_NAME=Qwen/Qwen3-VL-8B-Instruct

# The AURA worker sends older video frames and dialogue to this endpoint.
# Keep the model name equal to MEMORY_VLM_SERVED_NAME and the port equal to
# MEMORY_VLM_PORT. Local serving does not need an OpenAI API key.
export AURA_MEMORY_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
export AURA_MEMORY_VLM_URL=http://127.0.0.1:8003/v1/chat/completions

export AURA_MEMORY_INTERVAL_S=30
export AURA_MEMORY_MIN_ROUNDS=6
export AURA_MEMORY_KEEP_ROUNDS=4
export AURA_MEMORY_MAX_FRAMES=8
export AURA_MEMORY_TIMEOUT_S=30
