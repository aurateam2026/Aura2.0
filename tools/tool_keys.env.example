# Optional credentials for the AURA gateway's DeepSeek tools.
# Copy to deploy/runtime/tool_keys.env; never commit real credentials.
# Values are read as literal NAME=value entries: do not add export or quotes.
# Without this key, local conversation/time/location/weather still work;
# DeepSeek tools return a configuration error if the model calls them.
DEEPSEEK_API_KEY=
# Optional model override for visual_web_search only (provider access required).
DEEPSEEK_VISION_MODEL=deepseek-flash
